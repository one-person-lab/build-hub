# 站点对外地址，用于拼微信的 notify_url（生产必填）
APP_URL=https://your-domain.com

# ---- 邮箱验证码登录（SMTP）----
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=授权码而非登录密码
# SMTP_FROM 缺省时使用 SMTP_USER

# ---- SQLite ----
# 默认 ./data/buildhub.db；Docker 内为 /app/data/buildhub.db
# DATA_PATH=/app/data/buildhub.db

# ---- 微信支付直连（APIv3 / Native 扫码）----
# 商户平台「账户中心 → API安全」：证书序列号与 APIv3 密钥在这里看
WXPAY_MCHID=商户号
WXPAY_SERIAL_NO=商户API证书序列号
WXPAY_APIV3_KEY=32位APIv3密钥
# 私钥文件只放服务器，绝不进 git：Docker 内挂 /app/secrets/apiclient_key.pem
WXPAY_KEY_PATH=/app/secrets/apiclient_key.pem
# Native 下单必填，缺了微信回 400「公众号ID必填」
WXPAY_APPID=wx开头的应用ID
# 若改用「微信支付公钥」验签（当前号未启用），再填这两项
# WXPAY_PUBLIC_KEY_PATH=/app/secrets/wxpay_pub_key.pem

# ---- 微信扫码登录（微信开放平台「网站应用」，与上面支付那套凭据不通用）----
# 开放平台 → 账号中心 → 网站应用：拿 AppID 与 AppSecret；「微信登录」权限要单独申请开通
# 授权回调域填本站域名本体（不带协议和路径），例如 buildhub.cn；线上 APP_URL 必须与它同域
# 这两项不配时登录弹窗只显示邮箱验证码，不会出现微信按钮
WX_APPID=wx开头的网站应用ID
WX_SECRET=网站应用密钥

# ---- 真钱验证通道 ----
# ¥0.01「验证单」（给 1 天 PRO）常驻，只有这个邮箱能下单：账号页连点邮箱 5 次打开
# 不填就用代码里的默认值 136267719@qq.com；多个白名单用逗号分隔
# OWNER_EMAIL=136267719@qq.com

