# 站点对外地址，用于拼微信的 notify_url（生产必填）
APP_URL=https://your-domain.com

# ---- 邮箱验证码登录（SMTP）----
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=授权码而非登录密码
# SMTP_FROM 缺省时使用 SMTP_USER

# ---- SQLite ----
# 默认 ./data/buildhub.db；Docker 内为 /app/data/buildhub.db
# DATA_PATH=/app/data/buildhub.db

# ---- 微信支付直连（APIv3 / Native 扫码）----
# 商户平台「账户中心 → API安全」：证书序列号与 APIv3 密钥在这里看
WXPAY_MCHID=商户号
WXPAY_SERIAL_NO=商户API证书序列号
WXPAY_APIV3_KEY=32位APIv3密钥
# 私钥文件只放服务器，绝不进 git：Docker 内挂 /app/secrets/apiclient_key.pem
WXPAY_KEY_PATH=/app/secrets/apiclient_key.pem
# Native 下单必填，缺了微信回 400「公众号ID必填」
WXPAY_APPID=wx开头的应用ID
# 若改用「微信支付公钥」验签（当前号未启用），再填这两项
# WXPAY_PUBLIC_KEY_PATH=/app/secrets/wxpay_pub_key.pem

# ---- 微信登录（微信开放平台「网站应用」，与上面支付那套凭据不通用）----
# 开放平台 → 账号中心 → 网站应用：拿 AppID 与 AppSecret；「微信登录」权限要单独申请开通
# 授权回调域填本站域名本体（不带协议和路径），例如 buildhub.cn；线上 APP_URL 必须与它同域
# 登录弹窗内嵌新版登录框：电脑版微信已登录时是一键确认，否则仍是扫码。凭据还是这一对
# 这两项不配时登录弹窗只显示邮箱验证码，不会出现微信按钮
WX_APPID=wx开头的网站应用ID
WX_SECRET=网站应用密钥

# ---- 真钱验证通道 ----
# ¥0.01「验证单」（给 1 天 PRO）常驻，只有这个邮箱能下单：
# 开通 PRO 弹窗连点顶部 logo 5 次，或账号页连点邮箱 5 次
# 不填就用代码里的默认值 136267719@qq.com；多个白名单用逗号分隔
# OWNER_EMAIL=136267719@qq.com

# ---- Ops Console Admin API（/api/admin/*）----
# ops-console 经 /gateway/buildhub 反代调用时带 Authorization: Bearer <token>
# 与 ops-console 的 VITE_OPS_ADMIN_TOKEN 保持一致
# OPS_ADMIN_TOKEN=

# ---- GitHub 一键登录（OAuth App）----
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage URL 填站点根地址；Authorization callback URL 填：
#   https://你的域名/api/auth/github/callback
# 这两项不配时登录弹窗不显示 GitHub 按钮
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- /skills 的 GitHub 星数同步（默认每天一次）----
# 每天最多向 GitHub 拉一轮（当前 20 个仓库 = 20 次请求），结果存 SQLite，
# 进程重启 / dev 热更新也不会重复消耗配额；拉取失败时沿用上次的值
# 想临时手动同步：访问 /api/github-stars?refresh=1
# 可选：配 token 提高配额上限（每天一刷一般用不上）；与上面 OAuth 凭据不是同一套
# GITHUB_TOKEN=ghp_xxx
# 自定义同步间隔（分钟，默认 1440 = 24 小时）
# GITHUB_STARS_TTL_MINUTES=1440

